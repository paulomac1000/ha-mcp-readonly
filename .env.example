# Home Assistant connection
HA_URL=http://homeassistant:8123
HA_TOKEN=replace-with-a-home-assistant-long-lived-token
HA_CONFIG_PATH=/config

# Local default: stdio, no network listeners
MCP_TRANSPORT=stdio
MCP_BIND_HOST=127.0.0.1
MCP_PORT=9092
MCP_DEV_TOOLS_ENABLED=0

# Required only for MCP_TRANSPORT=http
# MCP_AUTH_TOKEN=replace-with-a-high-entropy-caller-token

# Optional health listener; enabled by default for network MCP and disabled for stdio
# HEALTH_SERVER_ENABLED=0
# HEALTH_CHECK_PORT=9091
# HA_BACKEND_REQUIRED_FOR_READY=0

# Optional authenticated REST compatibility adapter
# REST_API_ENABLED=0
# REST_API_TOKEN=replace-with-a-dedicated-token
# REST_API_PORT=9093
# CORS_ALLOWED_ORIGINS=http://localhost

# Context artifact containment and bounded time-series windows
OUTPUT_PATH=/app/output/ha-ai-context.md
CONTEXT_OUTPUT_ROOT=/app/output
HA_CONTEXT_HISTORY_HOURS=1
HA_CONTEXT_LOG_HOURS=24
HA_CONTEXT_CALENDAR_DAYS=30
HA_CONTEXT_MAX_SOURCE_BYTES=67108864
HA_CONTEXT_MAX_OUTPUT_BYTES=100663296

# Runtime
RUN_TESTS_ON_STARTUP=0
LOG_LEVEL=INFO
